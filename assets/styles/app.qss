/* ============================================================
   app.qss — tema azul y amarillo claro de la Biblioteca General POSTDATA

   Índice para editar rápido:
   1. Base global
   2. Ventana principal, sidebar y tarjetas
   3. Etiquetas de texto
   4. Botones
   5. Navegación lateral
   6. Campos de entrada (línea, combo y spin)
   7. Casillas y botones de radio
   8. Tablas y cabeceras
   9. Áreas de texto y splitter
   10. Plazo y tooltips
   ============================================================ */

/* ------------------------------------------------------------
   1. Base global
   ------------------------------------------------------------ */
QWidget {
  background-color: #f7fafe;
  color: #1d3350;
}

QMainWindow,
QDialog {
  background-color: #f7fafe;
}

QLabel {
  background-color: transparent;
  color: #1d3350;
}

/* ------------------------------------------------------------
   2. Ventana principal, sidebar y tarjetas
   ------------------------------------------------------------ */
QFrame#sidebarFrame {
  background-color: #eaf1fb;
  border-right: 1px solid #becfe6;
}

QFrame#contenidoFrame {
  background-color: #f7fafe;
}

QFrame[card='true'] {
  background-color: #ffffff;
  border: 1px solid #cfdcee;
  border-radius: 8px;
}

QFrame#separadorReportes {
  color: #becfe6;
  background-color: #becfe6;
  border: none;
}

/* ------------------------------------------------------------
   3. Etiquetas de texto
   ------------------------------------------------------------ */
QLabel#marca1Label {
  color: #13253b;
  font-weight: bold;
}

QLabel#marca2Label {
  color: #5b7796;
  font-style: italic;
}

QLabel#bienvenidaLabel {
  color: #13253b;
  font-weight: bold;
  font-size: 18px;
}

QLabel#tipoLabel,
QLabel#subtituloMembresiaLabel,
QLabel#reporteResumenLabel {
  color: #5b7796;
}

QLabel#menuLabel {
  color: #7791ad;
  font-weight: bold;
}

QLabel#tituloMembresiaLabel,
QLabel#tituloUsuariosLabel,
QLabel#tituloReportesLabel,
QLabel#tituloHistorialLabel,
QLabel#tituloInventarioLabel,
QLabel#tituloFormularioLabel,
QLabel#detalleEncabezadoLabel {
  color: #13253b;
  font-weight: bold;
}

/* ------------------------------------------------------------
   4. Botones
   Uso: rol='primary' para la acción principal, 'secondary' para
   acciones alternativas, 'danger' para borrar y 'ghost' para salir.
   El valor se pone en Qt Designer.
   ------------------------------------------------------------ */
QPushButton {
  background-color: #1e5aa8;
  color: #ffffff;
  border: 1px solid #174786;
  border-radius: 6px;
  padding: 7px 16px;
}

QPushButton:hover {
  background-color: #2e6fbe;
}

QPushButton:pressed {
  background-color: #174786;
}

QPushButton:disabled {
  background-color: #e6ebf2;
  color: #8a97a8;
  border-color: #cfd8e3;
}

QPushButton[rol='primary'] {
  background-color: #2465b4;
  border-color: #1c5499;
}

QPushButton[rol='primary']:hover {
  background-color: #3a7cc7;
}

QPushButton[rol='secondary'] {
  background-color: #f0b400;
  color: #2e2608;
  border-color: #c99400;
}

QPushButton[rol='secondary']:hover {
  background-color: #ffc933;
}

QPushButton[rol='secondary']:pressed {
  background-color: #c99400;
}

QPushButton[rol='danger'] {
  background-color: #b3261e;
  color: #ffffff;
  border-color: #8c1c17;
}

QPushButton[rol='danger']:hover {
  background-color: #ce3a30;
}

QPushButton[rol='danger']:pressed {
  background-color: #8c1c17;
}

QPushButton[rol='primary']:disabled,
QPushButton[rol='secondary']:disabled,
QPushButton[rol='danger']:disabled {
  background-color: #e6ebf2;
  color: #8a97a8;
  border-color: #cfd8e3;
}

QPushButton[rol='ghost'] {
  background-color: transparent;
  color: #3d5f82;
  border-color: #bdd0e8;
}

QPushButton[rol='ghost']:hover {
  background-color: #ffffff;
  color: #13253b;
  border-color: #2465b4;
}

/* ------------------------------------------------------------
   5. Navegación lateral
   Las filas se compactaron en principal.ui para no usar scroll.
   ------------------------------------------------------------ */
QListWidget#navegacionListWidget {
  background-color: transparent;
  border: none;
  outline: none;
}

QListWidget#navegacionListWidget::item {
  color: #2b4b6e;
  padding: 7px 10px;
  border-radius: 6px;
}

QListWidget#navegacionListWidget::item:hover {
  background-color: #ffffff;
}

QListWidget#navegacionListWidget::item:selected {
  background-color: #1e5aa8;
  color: #ffffff;
}

/* ------------------------------------------------------------
   6. Campos de entrada
   ------------------------------------------------------------ */
QLineEdit,
QComboBox,
QSpinBox {
  background-color: #ffffff;
  color: #1d3350;
  border: 1px solid #becfe6;
  border-radius: 6px;
  padding: 5px 8px;
  selection-background-color: #1e5aa8;
  selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
  border-color: #2e6fbe;
}

QComboBox::drop-down {
  border: none;
  width: 22px;
}

QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #1d3350;
  border: 1px solid #becfe6;
  selection-background-color: #1e5aa8;
  selection-color: #ffffff;
}

/* ------------------------------------------------------------
   7. Casillas de verificación
   ------------------------------------------------------------ */
QCheckBox {
  color: #2b4b6e;
  spacing: 8px;
}

/* ------------------------------------------------------------
   8. Tablas y cabeceras
   ------------------------------------------------------------ */
QTableWidget {
  background-color: #ffffff;
  alternate-background-color: #ffffff;
  color: #1d3350;
  gridline-color: #cfdcee;
  border: 1px solid #cfdcee;
  border-radius: 6px;
  selection-background-color: #194d91;
  selection-color: #ffffff;
}

QTableWidget::item {
  padding: 5px;
}

QHeaderView::section {
  background-color: #dce8f7;
  color: #1d3350;
  border: none;
  border-right: 1px solid #becfe6;
  border-bottom: 1px solid #becfe6;
  padding: 6px;
  font-weight: bold;
}

QTableCornerButton::section {
  background-color: #dce8f7;
  border: none;
}

/* ------------------------------------------------------------
   9. Áreas de texto y splitter
   ------------------------------------------------------------ */
QTextEdit {
  background-color: transparent;
  color: #1d3350;
  border: none;
  selection-background-color: #1e5aa8;
  selection-color: #ffffff;
}

QSplitter::handle {
  background-color: #becfe6;
}

/* ------------------------------------------------------------
   10. Plazo y tooltips
   El plazo se muestra como texto; la fecha se calcula sola a 15 días.
   ------------------------------------------------------------ */
QLabel#plazoFechaLimiteLabel {
  color: #5b7796;
}

QToolTip {
  background-color: #dce8f7;
  color: #1d3350;
  border: 1px solid #bdd0e8;
  padding: 4px;
}
