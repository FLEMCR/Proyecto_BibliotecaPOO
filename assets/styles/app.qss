/* ============================================================
   app.qss — tema oscuro de la Biblioteca General POSTDATA

   Índice para editar rápido:
   1. Base global
   2. Ventana principal, sidebar y tarjetas
   3. Etiquetas de texto
   4. Botones
   5. Navegación lateral
   6. Campos de entrada (línea, combo y spin)
   7. Casillas y botones de radio
   8. Tablas y cabeceras
   9. Áreas de texto y splitter
   10. Plazo y tooltips
   ============================================================ */

/* ------------------------------------------------------------
   1. Base global
   ------------------------------------------------------------ */
QWidget {
  background-color: #1b1e20;
  color: #eceff1;
}

QMainWindow,
QDialog {
  background-color: #1b1e20;
}

QLabel {
  background-color: transparent;
  color: #eceff1;
}

/* ------------------------------------------------------------
   2. Ventana principal, sidebar y tarjetas
   ------------------------------------------------------------ */
QFrame#sidebarFrame {
  background-color: #141618;
  border-right: 1px solid #2e3438;
}

QFrame#contenidoFrame {
  background-color: #1b1e20;
}

QFrame[card='true'] {
  background-color: #24282b;
  border: 1px solid #333a3f;
  border-radius: 8px;
}

QFrame#separadorReportes {
  color: #3d4449;
  background-color: #3d4449;
  border: none;
}

/* ------------------------------------------------------------
   3. Etiquetas de texto
   ------------------------------------------------------------ */
QLabel#marca1Label {
  color: #ffffff;
  font-weight: bold;
}

QLabel#marca2Label {
  color: #aab2b8;
  font-style: italic;
}

QLabel#bienvenidaLabel {
  color: #ffffff;
  font-weight: bold;
  font-size: 18px;
}

QLabel#tipoLabel,
QLabel#subtituloMembresiaLabel,
QLabel#reporteResumenLabel {
  color: #aab2b8;
}

QLabel#menuLabel {
  color: #7f878c;
  font-weight: bold;
}

QLabel#tituloMembresiaLabel,
QLabel#tituloUsuariosLabel,
QLabel#tituloReportesLabel,
QLabel#tituloHistorialLabel,
QLabel#tituloInventarioLabel,
QLabel#tituloFormularioLabel,
QLabel#detalleEncabezadoLabel {
  color: #ffffff;
  font-weight: bold;
}

/* ------------------------------------------------------------
   4. Botones
   Uso: rol='primary' para la acción principal y 'secondary'/'ghost'
   para acciones alternativas. El valor se pone en Qt Designer.
   ------------------------------------------------------------ */
QPushButton {
  background-color: #b03a2e;
  color: #ffffff;
  border: 1px solid #8c2d23;
  border-radius: 6px;
  padding: 7px 16px;
}

QPushButton:hover {
  background-color: #c74738;
}

QPushButton:pressed {
  background-color: #8c2d23;
}

QPushButton:disabled {
  background-color: #34393d;
  color: #7f878c;
  border-color: #2e3438;
}

QPushButton[rol='primary'] {
  background-color: #c0392b;
  border-color: #9f2d22;
}

QPushButton[rol='primary']:hover {
  background-color: #d64a3a;
}

QPushButton[rol='secondary'] {
  background-color: #34393d;
  border-color: #4a5156;
}

QPushButton[rol='secondary']:hover {
  background-color: #41474c;
}

QPushButton[rol='ghost'] {
  background-color: transparent;
  color: #d9dee2;
  border-color: #4a5156;
}

QPushButton[rol='ghost']:hover {
  background-color: #24282b;
  color: #ffffff;
  border-color: #c0392b;
}

/* ------------------------------------------------------------
   5. Navegación lateral
   Las filas se compactaron en principal.ui para no usar scroll.
   ------------------------------------------------------------ */
QListWidget#navegacionListWidget {
  background-color: transparent;
  border: none;
  outline: none;
}

QListWidget#navegacionListWidget::item {
  color: #d7dde1;
  padding: 7px 10px;
  border-radius: 6px;
}

QListWidget#navegacionListWidget::item:hover {
  background-color: #24282b;
}

QListWidget#navegacionListWidget::item:selected {
  background-color: #b03a2e;
  color: #ffffff;
}

/* ------------------------------------------------------------
   6. Campos de entrada
   ------------------------------------------------------------ */
QLineEdit,
QComboBox,
QSpinBox {
  background-color: #202427;
  color: #eceff1;
  border: 1px solid #3d4449;
  border-radius: 6px;
  padding: 5px 8px;
  selection-background-color: #b03a2e;
  selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
  border-color: #c0392b;
}

QComboBox::drop-down {
  border: none;
  width: 22px;
}

QComboBox QAbstractItemView {
  background-color: #24282b;
  color: #eceff1;
  border: 1px solid #3d4449;
  selection-background-color: #b03a2e;
  selection-color: #ffffff;
}

/* ------------------------------------------------------------
   7. Casillas y botones de radio
   Los radio buttons eligen la dimensión del reporte.
   ------------------------------------------------------------ */
QCheckBox {
  color: #d7dde1;
  spacing: 8px;
}

QRadioButton {
  color: #d7dde1;
  spacing: 6px;
  padding: 3px 2px;
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border-radius: 7px;
  border: 1px solid #4a5156;
  background-color: #202427;
}

QRadioButton::indicator:checked {
  background-color: #b03a2e;
  border: 2px solid #d64a3a;
}

/* ------------------------------------------------------------
   8. Tablas y cabeceras
   ------------------------------------------------------------ */
QTableWidget {
  background-color: #202427;
  alternate-background-color: #24282b;
  color: #eceff1;
  gridline-color: #333a3f;
  border: 1px solid #333a3f;
  border-radius: 6px;
  selection-background-color: #8c2d23;
  selection-color: #ffffff;
}

QTableWidget::item {
  padding: 5px;
}

QHeaderView::section {
  background-color: #2b3033;
  color: #eceff1;
  border: none;
  border-right: 1px solid #3d4449;
  border-bottom: 1px solid #3d4449;
  padding: 6px;
  font-weight: bold;
}

QTableCornerButton::section {
  background-color: #2b3033;
  border: none;
}

/* ------------------------------------------------------------
   9. Áreas de texto y splitter
   ------------------------------------------------------------ */
QTextEdit {
  background-color: transparent;
  color: #eceff1;
  border: none;
  selection-background-color: #b03a2e;
  selection-color: #ffffff;
}

QSplitter::handle {
  background-color: #2e3438;
}

/* ------------------------------------------------------------
   10. Plazo y tooltips
   El plazo se muestra como texto; la fecha se calcula sola a 15 días.
   ------------------------------------------------------------ */
QLabel#plazoFechaLimiteLabel {
  color: #aab2b8;
}

QToolTip {
  background-color: #2b3033;
  color: #eceff1;
  border: 1px solid #4a5156;
  padding: 4px;
}
