<ui version="4.0"><class>VentanaPrincipal</class><widget class="QMainWindow" name="VentanaPrincipal"><property name="geometry"><rect><x>0</x><y>0</y><width>900</width><height>680</height></rect></property><property name="windowTitle"><string>Biblioteca Universitaria | Inicio</string></property><widget class="QWidget" name="centralwidget"><property name="styleSheet"><string notr="true">QMainWindow, QWidget#centralwidget { background-color: #F4F7FB; color: #243247; font-family: "Segoe UI"; font-size: 10pt; }
QLabel#eyebrowLabel { color: #0F766E; font-size: 9pt; font-weight: bold; }
QLabel#tituloLabel { color: #172B4D; font-size: 23pt; font-weight: bold; }
QLabel#subtituloLabel, QLabel#bienvenidaLabel, QLabel#ayudaLabel { color: #64748B; font-size: 10pt; }
QFrame#topFrame, QFrame#cardFrame, QFrame#infoFrame { background-color: white; border: 1px solid #E2E8F0; border-radius: 12px; }
QPushButton { background-color: #0F766E; color: white; border: none; border-radius: 7px; padding: 10px 16px; font-weight: bold; min-height: 18px; }
QPushButton:hover { background-color: #115E59; }
QPushButton#volverButton, QPushButton#limpiarButton, QPushButton#salirButton, QPushButton#cancelarButton { background-color: #E2E8F0; color: #334155; }
QPushButton#volverButton:hover, QPushButton#limpiarButton:hover, QPushButton#salirButton:hover, QPushButton#cancelarButton:hover { background-color: #CBD5E1; }
QPushButton#catalogoButton, QPushButton#usuariosButton, QPushButton#membresiaButton, QPushButton#buscarMenuButton, QPushButton#prestamosButton, QPushButton#devolucionesButton { background-color: white; color: #172B4D; border: 1px solid #DCE5EF; border-radius: 10px; padding: 18px; text-align: left; min-height: 54px; font-size: 11pt; }
QPushButton#catalogoButton:hover, QPushButton#usuariosButton:hover, QPushButton#membresiaButton:hover, QPushButton#buscarMenuButton:hover, QPushButton#prestamosButton:hover, QPushButton#devolucionesButton:hover { background-color: #ECFDF5; border: 1px solid #0F766E; }
QLineEdit, QComboBox { background-color: white; border: 1px solid #CBD5E1; border-radius: 6px; padding: 9px; min-height: 20px; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #0F766E; }
QTableWidget { background-color: white; alternate-background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; gridline-color: #E2E8F0; selection-background-color: #CCFBF1; selection-color: #134E4A; }
QHeaderView::section { background-color: #EAF1F7; color: #334155; padding: 9px; border: none; border-bottom: 1px solid #D7E1EC; font-weight: bold; }
